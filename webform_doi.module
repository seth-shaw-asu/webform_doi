<?php

/**
 * @file
 * WebformDOI module file.
 */

use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Ajax\AjaxResponse;
use Drupal\Core\Ajax\InvokeCommand;

/**
 * Implements hook_form_alter().
 *
 * We want to target the webform submission form for our specific webform,
 * which has a unique attribute 'doi-integration' on the form element.
 */
function webform_doi_form_alter(&$form, FormStateInterface $form_state, $form_id): void {
  // Only looking for webform submission forms.
  if (strpos($form_id, 'webform_submission') === 0) {
    // Specifically, *our* webform with the DOI lookup integration.
    if (array_key_exists('doi-integration', $form['#attributes'])) {
      $found = webform_doi_find_doi_field($form['elements']);
      if ($found) {
        $form['#attached']['library'][] = 'webform_doi/doi_lookup';
      }
    }
  }
}

/**
 * Recursively find the form DOI element.
 */
function webform_doi_find_doi_field(array &$elements): bool {
  foreach ($elements as $element_id => &$element) {
    if (strpos($element_id, '#') === 0) {
      // Skip the properties starting with #.
      continue;
    }
    // Walk containers.
    if ($element['#type'] === 'container') {
      $found = webform_doi_find_doi_field($element);
      if ($found) {
        return TRUE;
      }
    }
    elseif ($element['#type'] === 'textfield' && $element['#wrapper_attributes']['data-doi-field'] === 'doi') {
      $element['#ajax'] = [
        'callback' => 'webform_doi_ajax_populate_callback',
        'event' => 'doi_entry',
        'progress' => ['type' => 'throbber', 'message' => NULL],
      ];
      // Add a delay to debounce the AJAX calls.
      $element['#attributes']['data-delay'] = 500;
      return TRUE;
    }
  }
  // Our walk found no DOI field in this branch.
  return FALSE;
}

/**
 * AJAX callback to fetch metadata from CrossRef and populate form fields.
 */
function webform_doi_ajax_populate_callback(array &$form, FormStateInterface $form_state) {
  \Drupal::logger('webform_doi')->notice('AJAX callback triggered for DOI lookup');
  $triggering_element = $form_state->getTriggeringElement();
  $doi_parents = $triggering_element['#parents'];
  $doi = $form_state->getValue($doi_parents);
  \Drupal::logger('webform_doi')->notice('DOI entered: @doi', ['@doi' => $doi]);
  if (!empty($doi)) {
    try {
      $client = \Drupal::httpClient();
      $url = 'https://api.crossref.org/works/' . urlencode($doi);
      $response = $client->get($url);
      $data = json_decode($response->getBody(), TRUE);

      if ($data && isset($data['message'])) {
        $updates = [];
        webform_doi_traverse_form($form['elements'], $form_state, $data['message'], $updates);
        $ajax_response = new AjaxResponse();
        foreach ($updates as $update) {
          $ajax_response->addCommand(new InvokeCommand($update['selector'], 'val', [$update['value']]));
        }
        \Drupal::messenger()->addStatus('DOI metadata loaded successfully');
        return $ajax_response;
      }
      else {
        \Drupal::messenger()->addError('Invalid response from CrossRef API');
        return new AjaxResponse();
      }
    }
    catch (\Exception $e) {
      \Drupal::messenger()->addError('Error fetching DOI: ' . $e->getMessage());
      return new AjaxResponse();
    }
  }

  return new AjaxResponse();
}

/**
 * Recursively find and populate fields with data-doi-field attributes.
 */
function webform_doi_traverse_form(array &$elements, FormStateInterface $form_state, array $metadata, array &$updates) {
  foreach ($elements as $key => &$element) {
    if (strpos($key, '#') === 0) {
      // Skip properties starting with #.
      continue;
    }
    if (isset($element['#wrapper_attributes']['data-doi-field']) && $element['#wrapper_attributes']['data-doi-field'] !== 'doi') {
      if (is_array($element['#wrapper_attributes']['data-doi-field'])) {
        $field_names = $element['#wrapper_attributes']['data-doi-field'];
      }
      else {
        $field_names = [$element['#wrapper_attributes']['data-doi-field']];
      }
      \Drupal::logger('webform_doi')->notice('Found element with data-doi-field: @field', ['@field' => implode(', ', $field_names)]);
      $values = [];
      foreach ($field_names as $field_name) {
        $value = webform_doi_get_value_from_metadata($metadata, trim($field_name));
        if ($value !== NULL) {
          if (is_array($value)) {
            $values = array_merge($values, $value);
          } else {
            $values[] = $value;
          }
        }
      }
      if (!empty($values)) {
        // For multiple values, join them or handle accordingly.
        // For now, use the first value.
        \Drupal::logger('webform_doi')->notice('Setting value for element @key: @value', [
          '@key' => $key,
          '@value' => implode(', ', $values),
        ]);

        $base_id = preg_replace('/--.+$/', '', $element['#id']);
        if ($element['#type'] === 'webform_multiple') {
          $default_value = [];
          if (is_array($values)) {
            foreach ($values as $index => $value) {
              $default_value[] = ['_item_' => $value, 'weight' => $index];
            }
          } else {
            $default_value = [['_item_' => $values, 'weight' => 0]];
          }
          $element['#default_value'] = $default_value;
          $form_state->setValue($element['#parents'], $default_value);
          // Update multiple items if values is an array.
          if (is_array($values)) {
            foreach ($values as $index => $value) {
              $input_id = $base_id . '-items-' . $index . '-item-';
              $selector = '#' . $input_id;
              \Drupal::logger('webform_doi')->notice('Updating selector @selector with value @value', [
                '@selector' => $selector,
                '@value' => $value,
              ]);
              $updates[] = ['selector' => $selector, 'value' => $value];
            }
          }
          else {
            // Fallback to single value.
            $input_id = $base_id . '-items-0-item-';
            $selector = '#' . $input_id;
            $value = $values;
            \Drupal::logger('webform_doi')->notice('Updating selector @selector with value @value', [
              '@selector' => $selector,
              '@value' => $value,
            ]);
            $updates[] = ['selector' => $selector, 'value' => $value];
          }
        }
        else {
          $value = reset($values);
          $element['#default_value'] = $value;
          $element['#value'] = $value;
          $form_state->setValue($element['#parents'], $value);
          // Determine input ID based on element type.
          if (($element['#type'] ?? '') === 'textfield' || ($element['#type'] ?? '') === 'textarea') {
            $input_id = $base_id;
          }
          else {
            // For other webform elements, assume single value input ID pattern.
            $input_id = $element['#id'] . '-0-value';
          }
          $selector = '#' . $input_id;
          \Drupal::logger('webform_doi')->notice('Updating selector @selector with value @value', [
            '@selector' => $selector,
            '@value' => $value,
          ]);
          $updates[] = ['selector' => $selector, 'value' => $value];
        }
        \Drupal::logger('webform_doi')->notice('Element structure: @element', ['@element' => print_r($element, TRUE)]);
      }
    }
    elseif (isset($element['#type']) && $element['#type'] === 'container') {
      webform_doi_traverse_form($element, $form_state, $metadata, $updates);
    }
  }
}

/**
 * Extract value from metadata based on field path.
 */
function webform_doi_get_value_from_metadata(array $metadata, string $field_path) {
  $parts = explode('.', $field_path);
  $current = $metadata;
  foreach ($parts as $part) {
    if (isset($current[$part])) {
      $current = $current[$part];
    }
    else {
      return NULL;
    }
  }
  if (is_array($current)) {
    // Handle date-parts specifically.
    if ($part === 'date-parts' && is_array($current) && isset($current[0]) && is_array($current[0])) {
      $date_parts = $current[0];
      $value = '';
      foreach ($date_parts as $index => $date_part) {
        if ($index > 0) {
          $value .= '-';
        }
        $value .= str_pad((string) $date_part, 2, '0', STR_PAD_LEFT);
      }
      return $value;
    }
    // Special handling for author field.
    if ($field_path === 'author') {
      $names = [];
      foreach ($current as $author) {
        $name = '';
        if (isset($author['given'])) {
          $name .= $author['given'] . ' ';
        }
        if (isset($author['family'])) {
          $name .= $author['family'];
        }
        $names[] = trim($name);
      }
      return $names;
    }
    // For other arrays, return the first string element if available.
    foreach ($current as $item) {
      if (is_string($item)) {
        return $item;
      }
    }
    return NULL;
  }
  return is_string($current) ? $current : NULL;
}
