<?php

/**
 * @file
 * WebformDOI module file.
 */

use GuzzleHttp\Exception\ClientException;
use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Ajax\AjaxResponse;
use Drupal\Core\Ajax\InvokeCommand;
use Drupal\Core\Ajax\MessageCommand;

/**
 * Implements hook_form_alter().
 *
 * We want to target the webform submission form for our specific webform,
 * which has a unique attribute 'doi-integration' on the form element.
 */
function webform_doi_form_alter(&$form, FormStateInterface $form_state, $form_id): void {
  // Only looking for webform submission forms.
  // Specifically, *our* webform with the DOI lookup integration.
  if (strpos($form_id, 'webform_submission') === 0 && array_key_exists('doi-integration', $form['#attributes'])) {
    // Recursively find the DOI field and set up AJAX on it.
    webform_doi_find_doi_field($form['elements']);
  }
}

/**
 * Recursively find the form DOI element.
 */
function webform_doi_find_doi_field(array &$elements): bool {
  foreach ($elements as $element_id => &$element) {
    if (strpos($element_id, '#') === 0) {
      // Skip the properties starting with #.
      continue;
    }
    // Walk containers.
    if ($element['#type'] === 'container') {
      $found = webform_doi_find_doi_field($element);
      if ($found) {
        return TRUE;
      }
    }
    elseif ($element['#type'] === 'textfield' && $element['#wrapper_attributes']['data-doi-field'] === 'doi') {
      // Found the DOI field, attach our library and set up AJAX.
      $element['#attached']['library'][] = 'webform_doi/doi_lookup';
      $element['#ajax'] = [
        'callback' => 'webform_doi_ajax_populate_callback',
        'event' => 'doi_entry',
        'progress' => ['type' => 'throbber', 'message' => NULL],
      ];
      // Add a delay to debounce the AJAX calls.
      $element['#attributes']['data-delay'] = 1000;
      return TRUE;
    }
  }
  // Our walk found no DOI field in this branch.
  return FALSE;
}

/**
 * AJAX callback to fetch metadata from CrossRef and populate form fields.
 */
function webform_doi_ajax_populate_callback(array &$form, FormStateInterface $form_state) {
  $triggering_element = $form_state->getTriggeringElement();
  $doi_parents = $triggering_element['#parents'];
  $doi = $form_state->getValue($doi_parents);
  if (empty($doi)) {
    return new AjaxResponse();
  }
  $ajax_response = new AjaxResponse();
  try {
    $client = \Drupal::httpClient();
    $url = 'https://api.crossref.org/works/' . urlencode($doi);
    $response = $client->get($url);
    $data = json_decode($response->getBody(), TRUE);

    if ($data && isset($data['message'])) {
      $updates = [];
      webform_doi_traverse_form($form['elements'], $form_state, $data['message'], $updates);

      foreach ($updates as $update) {
        $ajax_response->addCommand(new InvokeCommand($update['selector'], 'val', [$update['value']]));
      }
      $ajax_response->addCommand(new MessageCommand('Metadata for DOI "' . $doi . '" has been populated.'));
      return $ajax_response;
    }
    else {
      \Drupal::logger('webform_doi')->warning('Invalid response from CrossRef API for doi "@doi": @response_code', [
        '@doi' => $doi,
        '@response_code' => $response->getStatusCode(),
      ]);
      $ajax_response->addCommand(new MessageCommand('Error fetching DOI metadata for "' . $doi . '". Please check the DOI and try again.'));
      return $response;
    }
  }
  catch (\Exception $e) {
    $message = "Error fetching DOI metadata for DOI '" . $doi . "'. ";
    if ($e instanceof ClientException && $e->getResponse()->getStatusCode() === 404) {
      $message .= '<br>DOI not found. Please check the DOI and try again.';
    }
    else {
      // We're not going to log every missing DOI checked,
      // but we do want to log other types of errors.
      \Drupal::logger('webform_doi')->warning('Error fetching DOI "@doi": @message', [
        '@doi' => $doi,
        '@message' => $e->getMessage(),
      ]);
    }
    $ajax_response->addCommand(new MessageCommand($message));
    return $ajax_response;
  }
}

/**
 * Recursively find and populate fields with data-doi-field attributes.
 */
function webform_doi_traverse_form(array &$elements, FormStateInterface $form_state, array $metadata, array &$updates) {
  foreach ($elements as $key => &$element) {
    if (strpos($key, '#') === 0) {
      // Skip properties starting with #.
      continue;
    }
    // Walk containers.
    if (isset($element['#type']) && $element['#type'] === 'container') {
      webform_doi_traverse_form($element, $form_state, $metadata, $updates);
    }
    // Check for our custom data attribute to map metadata fields.
    elseif (isset($element['#wrapper_attributes']['data-doi-field']) && $element['#wrapper_attributes']['data-doi-field'] !== 'doi') {
      // Grab field names as an array.
      $field_names = (is_array($element['#wrapper_attributes']['data-doi-field'])) ? $element['#wrapper_attributes']['data-doi-field'] : [$element['#wrapper_attributes']['data-doi-field']];
      $values = [];
      foreach ($field_names as $field_name) {
        $value = webform_doi_get_value_from_metadata($metadata, trim($field_name));
        if ($value !== NULL) {
          if (is_array($value)) {
            $values = array_merge($values, $value);
          }
          else {
            $values[] = $value;
          }
        }
      }
      if (empty($values)) {
        continue;
      }
      // Multi-valued.
      if ($element['#type'] === 'webform_multiple') {
        $default_value = [];
        foreach ($values as $index => $value) {
          // Form state.
          $default_value[] = ['_item_' => $value, 'weight' => $index];

          // AJAX selector - use data-drupal-selector attribute to avoid hash issues.
          // The data-drupal-selector attribute contains the base name without the hash
          // that Drupal appends to ensure unique IDs in the rendered form.
          $base_selector = $element['#attributes']['data-drupal-selector'] ?? '';
          if ($base_selector) {
            $selector = '[data-drupal-selector="' . $base_selector . '-items-' . $index . '-item-"]';
          }
          else {
            // Fallback to ID-based selector if data-drupal-selector is not available.
            $input_id = preg_replace('/--.+$/', '', $element['#id']) . '-items-' . $index . '-item-';
            $selector = '#' . $input_id;
          }
          $updates[] = ['selector' => $selector, 'value' => $value];
        }
        $element['#default_value'] = $default_value;
        $form_state->setValue($element['#parents'], $default_value);
      }
      // Single-valued.
      else {
        $value = reset($values);
        $element['#default_value'] = $value;
        $element['#value'] = $value;
        $form_state->setValue($element['#parents'], $value);
        // Determine selector based on element type.
        if (($element['#type'] ?? '') === 'textfield' || ($element['#type'] ?? '') === 'textarea') {
          // Use data-drupal-selector attribute if available for consistency.
          $base_selector = $element['#attributes']['data-drupal-selector'] ?? '';
          if ($base_selector) {
            $selector = '[data-drupal-selector="' . $base_selector . '"]';
          }
          else {
            $input_id = preg_replace('/--.+$/', '', $element['#id']);
            $selector = '#' . $input_id;
          }
        }
        else {
          // For other webform elements, use data-drupal-selector if available.
          $base_selector = $element['#attributes']['data-drupal-selector'] ?? '';
          if ($base_selector) {
            $selector = '[data-drupal-selector="' . $base_selector . '-0-value"]';
          }
          else {
            $input_id = preg_replace('/--.+$/', '', $element['#id']) . '-0-value';
            $selector = '#' . $input_id;
          }
        }
        $updates[] = ['selector' => $selector, 'value' => $value];
      }
    }
  }
}

/**
 * Extract value from metadata based on field path.
 */
function webform_doi_get_value_from_metadata(array $metadata, string $field_path) {
  $parts = explode('.', $field_path);
  $current = $metadata;
  foreach ($parts as $part) {
    if (isset($current[$part])) {
      $current = $current[$part];
    }
    else {
      return NULL;
    }
  }
  if (is_array($current)) {
    // Handle date-parts specifically.
    if ($part === 'date-parts' && is_array($current) && isset($current[0]) && is_array($current[0])) {
      $date_parts = $current[0];
      // Assemble date string in YYYY-MM-DD format, padding with zeros.
      $value = '';
      foreach ($date_parts as $index => $date_part) {
        if ($index > 0) {
          $value .= '-';
        }
        $value .= str_pad((string) $date_part, 2, '0', STR_PAD_LEFT);
      }
      return $value;
    }
    // Special handling for author field.
    if ($field_path === 'author') {
      $names = [];
      foreach ($current as $author) {
        $name = '';
        if (isset($author['given'])) {
          $name .= $author['given'] . ' ';
        }
        if (isset($author['family'])) {
          $name .= $author['family'];
        }
        $names[] = trim($name);
      }
      return $names;
    }
    // For other arrays, return the first string element if available.
    foreach ($current as $item) {
      if (is_string($item)) {
        return $item;
      }
    }
    return NULL;
  }
  return is_string($current) ? $current : NULL;
}
